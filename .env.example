OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# xAI Grok (OpenAI-compatible)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Anthropic
ANTHROPIC_API_KEY=
# Storage
LLMTESTER_DB=results/llmtester.db
